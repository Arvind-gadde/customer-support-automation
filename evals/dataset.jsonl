{"id": "faq-return-window", "message": "How many days do I have to return a shirt?", "expect_intent": "faq", "expect_status": "completed", "must_include_any": ["10 days", "ten days"]}
{"id": "faq-cod-fee", "message": "Is there an extra charge if I pay cash on delivery?", "expect_intent": "faq", "expect_status": "completed", "must_include_any": ["25"]}
