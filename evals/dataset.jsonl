{"id": "faq-failed-payment", "message": "Money got debited but my order failed, what now?", "expect_intent": "faq", "expect_status": "completed", "must_include_any": ["5-7", "5 to 7", "automatically"]}
{"id": "faq-otp-safety", "message": "Someone from Acme called asking for my OTP, is that normal?", "expect_intent": "any", "expect_status": "any", "must_include_any": ["never", "support team"]}
