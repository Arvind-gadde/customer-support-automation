{"id": "acct-big-refund", "message": "Refund the full amount for ORD-1001, the headphones stopped working", "expect_intent": "account", "expect_status": "awaiting_approval", "must_include_any": []}
{"id": "human-request", "message": "I want to speak to a real person right now", "expect_intent": "human", "expect_status": "awaiting_human", "must_include_any": []}
{"id": "human-legal", "message": "This is fraud, I'm going to file a consumer court case against you", "expect_intent": "human", "expect_status": "awaiting_human", "must_include_any": []}
